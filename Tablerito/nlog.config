<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <variable name="logFormat"
            value="${longdate} ${level:uppercase=true} ${logger} - ${message} ${exception:format=tostring}" />

  <targets>
    <target xsi:type="Console" name="console" layout="${logFormat}" />
    <target xsi:type="File" name="file" fileName="tablerito.log" layout="${logFormat}" />
  </targets>

  <rules>
    <!-- From the framework, only the startup and warnings or errors: otherwise it logs every request -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console,file" final="true" />
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Info" writeTo="console,file" />
  </rules>
</nlog>
